# Port for the Node API server
PORT=5000

# Connection string for MongoDB (the host "mongodb" is the Docker Compose service name)
MONGODB_URI=mongodb://mongodb:27017/CardsDB # Example

# Secret used to sign login tokens. Use a long random value, for example the
# output of:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts (examples: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# Google Gemini API credentials and model used for clothing image analysis
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Used only when the primary model has a temporary service failure or timeout.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
