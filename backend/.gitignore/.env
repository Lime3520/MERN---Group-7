# Port for the Node API server
PORT=5000

# Connection string for MongoDB (the host "mongodb" is the Docker Compose service name)
MONGODB_URI= #TODO

# Secret used to sign login tokens. Use a long random value, for example the
# output of:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a0d18646c6cfa14a5f9f85035539a43aee9cec3b5dd7520fa08efcf8c0a120a97767eae98f458c40b4a3df366414fef3

# How long a login lasts (examples: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

